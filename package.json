{
  "name": "mcp-reverse",
  "version": "1.3.0",
  "description": "Reverse transports for MCP (Model Context Protocol) — SSE engine. Allows internal MCP servers behind NAT/firewall to connect out to public MCP clients.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChineseAStar/mcp-reverse"
  },
  "bugs": {
    "url": "https://github.com/ChineseAStar/mcp-reverse/issues"
  },
  "homepage": "https://github.com/ChineseAStar/mcp-reverse#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sse",
    "server-sent-events",
    "reverse",
    "transport",
    "proxy",
    "nat",
    "firewall"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-reverse": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connector": {
      "types": "./dist/connector/index.d.ts",
      "import": "./dist/connector/index.js"
    },
    "./client": {
      "types": "./dist/connector/index.d.ts",
      "import": "./dist/connector/index.js"
    },
    "./acceptor": {
      "types": "./dist/acceptor/index.d.ts",
      "import": "./dist/acceptor/index.js"
    },
    "./sse": {
      "types": "./dist/sse/index.d.ts",
      "import": "./dist/sse/index.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy/index.d.ts",
      "import": "./dist/proxy/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "test:watch": "node --test --watch --import tsx tests/**/*.test.ts",
    "test:e2e": "node --test --import tsx tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@types/node": ">=18"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
